fn main() {
# Codegen: arr[i] reads — every vec element type, in bounds
vec<int32> nums = [10, 20, 30];
print(nums[0], " ", nums[2], "\n");

# expression index
print(nums[1 + 1], "\n");

vec<string> words = ["Quil", "rocks"];
print(words[0], " ", words[1], "\n");

vec<float32> ratios = [1.5, 2.5];
print(ratios[1], "\n");

vec<char> letters = ['a', 'b', 'c'];
print(letters[0], letters[1], letters[2], "\n");

# bounds checking stays quiet in-bounds
print("ok\n");

# Codegen: arr[i] writes — bounds-checked element assignment
nums[0] = 99;
print("after write: ", nums[0], "\n");

# expression index + expression value
nums[1 + 1] = nums[0] - 9;
print("after expr write: ", nums[2], "\n");

# variable index
int32 i = 1;
nums[i] = nums[i] + 1;
print("after var-index write: ", nums[1], "\n");

# writes on other element types
words[1] = "Quil";
print(words[1], "\n");
ratios[0] = 9.5;
print(ratios[0], "\n");
letters[0] = 'z';
print(letters[0], "\n");
}