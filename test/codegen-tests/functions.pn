fn greet() {
        println("hi")
}
fn add(int32 a, int32 b) : int32 {
        return a + b
}
fn sum_three(int32 a, int32 b, int32 c) : int32 {
        return add(add(a, b), c)
}
fn factorial(int32 n) : int32 {
        if (n <= 1) {
                return 1
        }
        return n * factorial(n - 1)
}

fn main() {
# Codegen test: functions (void, return value, nested calls, recursion)
# also exercises println (auto trailing newline)




greet()
println("add = ", add(3, 4))
println("sum = ", sum_three(1, 2, 3))
println("fact = ", factorial(5))

}