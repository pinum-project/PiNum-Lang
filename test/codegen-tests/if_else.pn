fn main() {
# Codegen: if / else / else if
int32 a = 10;
int32 b = 3;
if (a > b) {
        print("a is bigger\n");
}
if (a < b) {
        print("a is smaller\n");
} else {
        print("a is not smaller\n");
}
if (a < b) {
        print("a is smaller\n");
} else if (a > b) {
        print("a is bigger (else if)\n");
} else {
        print("equal\n");
}

}