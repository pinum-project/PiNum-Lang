fn main() {
# AST: nested control structures
int32 outer = 5;
int32 inner = 3;
if (outer > 0) {
        while (inner > 0) {
                if (inner == 1) {
                        print("deep\n");
                }
                inner = inner - 1;
        }
} else {
        print("else\n");
}

}