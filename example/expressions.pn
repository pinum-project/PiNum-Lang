fn main() {
# Semicolons are optional — a newline ends a statement.
# They ARE required to put multiple statements on one line:
#   int32 x = 1; print(x, "\n");   # two statements, one line
# arithmetic
int32 a = 10;
int32 b = 3
print(a + b, "\n")
print(a - b, "\n"); print(a * b, "\n")
print(a / b, "\n")
print(a % b, "\n")

# char repetition: 'c' * n (or n * 'c') repeats the char n times
char mark = '*'
print(mark * 6, "\n")
print(4 * '-', "\n")
print('.' * (a - b), "\n")

# string addition: "a" + "b" concatenates the two strings
string first = "foo"
string second = "bar"
print(first + second, "\n")
print(first + second + "!", "\n")
print("concatenation works with " + "literals too", "\n")

# precedence: * and / bind tighter than + and -
int32 c = 4
print(a + b * c, "\n")
print((a + b) * c, "\n")

# comparison
print(a > b, "\n")
print(a >= b, "\n")
print(a < b, "\n")
print(a <= b, "\n")
print(a == b, "\n")
print(a != b, "\n")

# logical
bool t = true
bool f = false
print(t && f, "\n")
print(t || f, "\n")
print(t && t || f, "\n")

# expressions in assignments
int32 result = a + b
print(result, "\n")
result = (a + b) * c
print(result, "\n")

# ternary: condition ? then : else
print(a > b ? 100 : 200, "\n")
print(a < b ? 100 : 200, "\n")
int32 max = a > b ? a : b
print(max, "\n")

int32 data
print('Enter data: ')
read(data)
print(data, '\n')

}