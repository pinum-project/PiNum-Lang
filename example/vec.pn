fn main() {
# vec<T> — a growable vector, monomorphized per element type.
#
# Each `vec<T>` compiles to its own C struct with by-value contiguous
# storage — vec_int, vec_float, vec_double, vec_char, vec_bool, vec_string —
# so there is no pointer boxing and elements are cache-friendly.

# --- int32 vector (literal syntax [ ... ]) ---
vec<int32> nums = [3, 5, 6]
print(nums, "\n")

# --- float32 / float64 ---
vec<float32> ratios = [1.5, 2.5]
print(ratios, "\n")
vec<float64> dbl = [3.14159, 2.71828]
print(dbl, "\n")

# --- char / bool / string ---
vec<char> letters = ['a', 'b', 'c']
print(letters, "\n")
vec<bool> flags = [true, false, true]
print(flags, "\n")
vec<string> words = ["PiNum", "rocks"]
print(words, "\n")

# --- mixing vecs with scalars in one print ---
print("nums: ", nums, " | words: ", words, "\n")

# --- empty vector ---
vec<int32> empty = []
print(empty, "\n")

# --- runtime helpers also expose append (wired when methods land) ---
# (generated C: __pinum_vec_int_append(&nums, 7))

# --- method calls: obj.append(x) ---
# appends an element to the vector (expands to __pinum_vec_<t>_append)
nums.append(7)
nums.append(8)
print(nums, "\n")
words.append("lang")
print(words, "\n")

# --- property reads: obj.size ---
print("nums size: ", nums.size, "\n")

# --- method call args can be any expression ---
int32 extra = 21
nums.append(extra * 2)
print(nums, "\n")

# --- element assignment: arr[index] = value ---
# writes are bounds-checked just like reads (panic on out-of-bounds)
nums[0] = 99
print("after nums[0] = 99: ", nums, "\n")

# the index can be any expression; so can the value
int32 idx = 1
nums[idx] = nums[idx] * 10
nums[2] = extra + 1
print(nums, "\n")

# works for every element type
words[0] = "Pi"
ratios[0] = 5.5
letters[1] = 'Z'
dbl[1] = dbl[1] + 1.0
print(words, " ", ratios, " ", letters, " ", dbl, "\n")

}