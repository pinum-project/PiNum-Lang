fn main() {
# Semicolons are optional — a newline ends a statement.
# They ARE required to put multiple statements on one line:
#   int32 x = 1; print(x, "\n");   # two statements, one line

# all basic data types, with a value
int32 count = 10;
float32 ratio = 3.5
float64 pi = 3.14159
char letter = 'A'
string name = "quil"
bool done = true
print(count, "\n")
print(ratio, "\n")
print(pi, "\n")
print(letter, "\n")
print(name, "\n")
print(done, "\n")

# all basic data types, declared without a value and assigned later
int32 a
float32 b
float64 c
char d
string e
bool f
a = 1
b = 2.5
c = 0.75
d = 'z'
e = "assigned later"
f = false
print(a, "\n")
print(b, "\n")
print(c, "\n")
print(d, "\n")
print(e, "\n")
print(f, "\n")

# byte types: uint8 and int8
uint32 u = 2147483647
uint8 uc = 65
int32 si = -5
int8 sc = -128
print(u, "\n")
print(uc, "\n")
print(si, "\n")
print(sc, "\n")

# modifiers: int64 with int32 and float64, int16 with int32
int64 li = 123456789
float64 ld = 0.123456789
int16 sh = -32768
print(li, "\n")
print(ld, "\n")
print(sh, "\n")

# read from the user
int32 number
float32 ratio2
print('Enter an int32: ')
read(number)
print('Enter a float32: ')
read(ratio2)
print(number, "\n")
print(ratio2, "\n")

}