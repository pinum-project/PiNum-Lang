fn square(int n) : int {
        return n * n
}
fn greet() {
        println("Hello from a function!")
}
fn factorial(int n) : int {
        if (n <= 1) {
                return 1
        }
        return n * factorial(n - 1)
}

fn main() {
# PiNum-Lang feature demonstration
# Literally every feature of the language lives in this one file.

# Semicolons are OPTIONAL — a newline ends a statement.
# But they ARE required to put multiple statements on one line:
#   int x = 1; print(x, "\n");   # two statements, one line

# --- variables and data types ---
int count = 10;
float ratio = 2.5
double pi = 3.14159
char letter = 'P'
string name = "PiNum"
bool ready = true
println("count  = ", count)
println("ratio  = ", ratio)
println("pi     = ", pi)
println("letter = ", letter)
println("name   = ", name)
println("ready  = ", ready)

# multiple statements on one line (needs semicolons)
int x = 5; println("x = ", x); x = x * 2; println("x*2 = ", x)

# --- type modifiers: long, short, unsigned, signed, long double ---
unsigned int big = 4000000000
long int li = 123456789
short int sh = -30000
long double ld = 0.123456789
signed char sc = -5
println("big = ", big, "  li = ", li, "  sh = ", sh, "  ld = ", ld, "  sc = ", sc)

# --- arithmetic ---
int a = 10
int b = 3
println("a + b = ", a + b)
println("a - b = ", a - b)
println("a * b = ", a * b)
println("a / b = ", a / b)
println("a % b = ", a % b)

# --- unary minus and logical not ---
int neg = -a
bool flag = false
println("neg = ", neg, "  !flag = ", !flag)

# --- char repetition (provided by the runtime library) ---
# 'c' * n (or n * 'c') repeats the char n times, returns a string
char bar = '='
println(bar * 30)
println('>', bar * 8, '<')
println(4 * '-')
# the multiplier can be any expression
println('#' * (a - b))

# building a pyramid, one line per row
int row = 0
while (row < 5) {
        println('*' * (row * 2 + 1))
        row = row + 1
}

# --- string addition (provided by the runtime library) ---
# "a" + "b" concatenates the two strings, returns a new string
string first = "PiNum"
string last = "-Lang"
println(first + last)
println("Hello, " + name + "!")

# --- comparisons and logicals ---
println("a > b        = ", a > b)
println("a == b       = ", a == b)
println("a != b       = ", a != b)
println("a > b && b>0 = ", a > b && b > 0)
println("a < b || b==3= ", a < b || b == 3)
println("!flag        = ", !flag)

# --- ternary ---
int max = a > b ? a : b
println("max = ", max)

# --- expressions in assignment ---
int c = 4
int result = (a + b) * 2
println("result = ", result)
result = a + b * c
println("result = ", result)

# --- compound assignment operators ---
int amount = 10
amount += 5       # same as amount = amount + 5
println("after += 5  = ", amount)
amount -= 3
println("after -= 3  = ", amount)
amount *= 2
println("after *= 2  = ", amount)
amount /= 3
println("after /= 3  = ", amount)
amount %= 4
println("after %= 4  = ", amount)

# --- increment / decrement ---
amount++
println("after ++ = ", amount)
amount--
println("after -- = ", amount)

# --- if / else if / else ---
if (a > b) {
        println("a is bigger")
} else if (a == b) {
        println("equal")
} else {
        println("b is bigger")
}

# --- nested if ---
if (a > 0) {
        if (b > 0) {
                println("both positive")
        }
}

# --- while loop ---
int i = 0
while (i < 5) {
        println("while i = ", i)
        i = i + 1
}

# --- break and continue ---
int j = 0
while (j < 10) {
        j = j + 1
        if (j % 2 == 0) {
                continue
        }
        if (j == 7) {
                break
        }
        println("odd j = ", j)
}

# --- for loop (three-part) ---
for (int f = 0; f < 5; f++) {
        println("for f = ", f)
}

# counted loop with a step
for (int step = 0; step < 10; step += 2) {
        println("step = ", step)
}

# counting down
for (int down = 5; down > 0; down--) {
        println("down = ", down)
}

# --- for (range) sugar ---
# for (N) runs the body N times: expands to
#   for (int __pinum_i0 = 0; __pinum_i0 < N; __pinum_i0++)
for (5) {
        println("beep")
}

# the range is any expression, evaluated each iteration
int sides = 3
for (sides) {
        println("side")
}

# nested range loops each get a unique hidden counter
for (3) {
        for (2) {
                print("*")
        }
        println()
}

# --- vec<T> — a growable vector, monomorphized per element type ---
vec<int> nums = [3, 5, 6]
println("nums = ", nums)
vec<float> ratios = [1.5, 2.5]
println("ratios = ", ratios)
vec<string> words = ["PiNum", "rocks"]
println("words = ", words)
vec<int> empty = []
println("empty = ", empty)

# --- vec method calls and property reads ---
nums.append(7)
println("after append = ", nums)
println("nums has ", nums.size, " elements")

# --- vec element access (read and write) ---
println("nums[0] = ", nums[0])
nums[1] = 99
println("nums[1] now = ", nums[1])

# --- functions ---
# define with: fn name(params): returnType { ... }
# the ': returnType' part is optional; omit it for a void function.
# recursion

int s = square(9)
println("square(9) = ", s)
greet()
println("5! = ", factorial(5))

# --- read user input ---
int data
println("Enter a number: ")
read(data)
println("you entered ", data)

# --- return (exits main early) ---
int m = 0
while (m < 10) {
        println("m = ", m)
        if (m == 3) {
                return 0
        }
        m = m + 1
}
println("never reached")

}