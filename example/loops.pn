fn main() {
# Semicolons are optional — a newline ends a statement.
# They ARE required to put multiple statements on one line:
#   int32 x = 1; print(x, "\n");   # two statements, one line

# while loop: count up
int32 i = 0;
while (i < 5) {
        print(i, "\n")
        i = i + 1
}

# continue: skip even numbers
int32 j = 0
while (j < 10) {
        j = j + 1
        if (j % 2 == 0) {
                continue
        }
        print(j, "\n")
}

# break: stop the loop early
int32 k = 0
while (k < 100) {
        k = k + 1
        if (k == 3) {
                break
        }
        print(k, "\n")
}

# for loop: for (init; condition; increment) { body }
# the classic counter loop
for (int32 i = 0; i < 5; i = i + 1) {
        print(i, "\n")
}

# shorter with the ++ operator
for (int32 i = 0; i < 5; i++) {
        print(i, "\n")
}

# init can assign to a variable declared outside the loop
int32 jj = 0
for (jj = 3; jj < 7; jj++) {
        print(jj, "\n")
}

# stepping by more than one with +=
for (int32 k = 0; k < 10; k += 2) {
        print(k, "\n")
}

# counting down with --
for (int32 n = 5; n > 0; n--) {
        print(n, "\n")
}

# empty parts: for(;;) is an infinite loop
int32 cnt = 0
for (;;) {
        cnt = cnt + 1
        if (cnt == 3) {
                break
        }
        print(cnt, "\n")
}

# continue skips the rest of the current iteration
for (int32 p = 0; p < 6; p++) {
        if (p % 2 == 0) {
                continue
        }
        print(p, "\n")
}

# nested for loops
for (int32 x = 0; x < 3; x++) {
        for (int32 y = 0; y < 2; y++) {
                print(x * y, "\n")
        }
}

# return: exit the loop and the program
int32 m = 0
while (m < 10) {
        print(m, "\n")
        if (m == 2) {
                return 7
        }
        m = m + 1
}
print("never reached\n")

}